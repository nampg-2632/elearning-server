NODE_ENV=development
PORT=3000
APP_NAME=e-Learning
APP_URL=http://localhost:3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173
FALLBACK_LANGUAGE=vi
# Reverse proxies in front of the app; 1 behind Caddy in production
TRUST_PROXY=0
DATABASE_URL=postgresql://elearning:change-me@localhost:5432/elearning
DATABASE_POOL_MAX=10
DATABASE_LOGGING=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=elearning:
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=86400

# Mail. Unset in development = Mailpit on localhost:1025 (docker compose
# points the app at the mailpit service); every mail lands in its web UI on
# http://localhost:8025 and nothing reaches a real inbox. Production sets
# them in the release workflow (see README, "Gửi mail").
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=e-Learning <no-reply@localhost>
# Mails per hour across every app instance; 0 = no limit
# MAIL_RATE_PER_HOUR=0

# docker compose (dev). Set POSTGRES_PASSWORD to a random string, e.g.
#   openssl rand -hex 24
POSTGRES_USER=elearning
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elearning
# Host ports, change when already in use on this machine
# APP_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
