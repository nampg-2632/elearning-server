{{#> layout}}
  <p>Chào {{fullName}},</p>
  <p>Đăng ký khoá học <strong>{{courseName}}</strong> của bạn chưa được duyệt.</p>
  {{#if reason}}<p>Lý do: {{reason}}</p>{{/if}}
  <hr style="border:none;border-top:1px solid #e4e7eb;margin:24px 0;" />
  <p>Hi {{fullName}},</p>
  <p>Your enrollment in <strong>{{courseName}}</strong> has been rejected.</p>
  {{#if reason}}<p>Reason: {{reason}}</p>{{/if}}
{{/layout}}
