{{#> layout}}
  <p>Chào {{fullName}},</p>
  <p>Quyền truy cập khoá học <strong>{{courseName}}</strong> của bạn đã bị thu hồi. Tiến độ học của bạn vẫn được giữ lại.</p>
  {{#if reason}}<p>Lý do: {{reason}}</p>{{/if}}
  <hr style="border:none;border-top:1px solid #e4e7eb;margin:24px 0;" />
  <p>Hi {{fullName}},</p>
  <p>Your access to <strong>{{courseName}}</strong> has been revoked. Your learning progress is kept.</p>
  {{#if reason}}<p>Reason: {{reason}}</p>{{/if}}
{{/layout}}
